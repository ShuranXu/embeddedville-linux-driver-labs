{
  "name": "EmbeddedVille Linux Driver Lab",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspaces/embeddedville-linux-driver-labs",
  "remoteUser": "vscode",
  "forwardPorts": [2222],
  "portsAttributes": {
    "2222": {
      "label": "QEMU guest SSH (localhost only)",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "./lab doctor",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "timonwong.shellcheck"]
    }
  }
}
